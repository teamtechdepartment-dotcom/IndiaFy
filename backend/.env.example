# MongoDB Connection URL
MongoDb_Url=mongodb+srv://<username>:<password>@cluster0.mongodb.net/indiafy?retryWrites=true&w=majority

# Server Configuration
PORT=8000

# JWT Token Secret Key
SecurityKey=your_jwt_security_secret_key_here
KYC_ENCRYPTION_KEY=your_kyc_encryption_key_here

# Email Configuration (Brevo / Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here
companyEmail=support@yourdomain.com

# Cloud Storage Configuration (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Wake / Self-Ping (Optional)
SERVER_URL=http://localhost:8000
KEEP_ALIVE_INTERVAL_MS=300000

# Payment Gateway Configuration (Razorpay)
Razorpay_Key_Id=rzp_test_your_razorpay_key_id
Razorpay_Key_Secret=your_razorpay_key_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Default Admin Credentials (for database initialization/seeding)
ADMIN_EMAIL=admin@indiafy.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_SECURITY_KEY=YourAdminSecurityKeyHere
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
